{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: mock_audio.py (issue #2 demo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/mock_audio.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: pytest test_mock_minimind_pipeline.py",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_mock_minimind_pipeline.py",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-x",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}