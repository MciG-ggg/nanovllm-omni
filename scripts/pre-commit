#!/usr/bin/env bash
# nanovllm-omni pre-commit hook.
#
# Runs the same lint + format + public-API checks the CI does, but
# only on the files staged for commit (so the hook is fast). Heavy
# checks (pytest, torch-requiring unit tests) are NOT run here -- they
# are too slow for a commit-time hook and live in the GitHub Actions
# workflow instead.
#
# Install: this script is symlinked into .git/hooks/pre-commit (see
# scripts/install-hooks.sh). To reinstall after a clean clone:
#   ./scripts/install-hooks.sh
#
# Skip on demand: git commit --no-verify ...

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Ensure uv-installed tools (ruff, black) are reachable even when the hook
# runs from a subprocess that doesn't inherit the user's interactive PATH
# (e.g. `pi-autoresearch log` spawns git commit in a stripped-down env).
# uv tool install places binaries at $HOME/.local/bin.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Pick the project's local venv tools when available so we don't depend
# on a globally-installed ruff / black.
RUFF=".venv/bin/ruff"
BLACK=".venv/bin/black"
[[ -x "$RUFF" ]] || RUFF="ruff"
[[ -x "$BLACK" ]] || BLACK="black"

# 1. Lint + format (full repo, fast on Python source).
echo "[pre-commit] ruff"
"$RUFF" check nanovllm_omni/ tests/ tools/

echo "[pre-commit] black"
"$BLACK" --check nanovllm_omni/ tests/ tools/

# 2. Public-API import smoke. This is fast (a few imports) but catches
# the most common regression class: a renamed or removed public symbol
# silently breaking Omni / AsyncOmni / etc. users. AGENTS.md lists this
# as part of the CI-equivalent checks.
echo "[pre-commit] public API import"
# Resolve a usable Python >= 3.10: prefer project venv, then `uv run`
# (uv resolves the project's pinned interpreter), then a few common
# Homebrew/Linuxbrew paths. `/usr/bin/python3` on macOS is Xcode's
# 3.9 and lacks `typing.TypeAlias`, so we never fall back to it blindly.
run_python() {
  if [[ -x ".venv/bin/python" ]]; then
    .venv/bin/python "$@"
  elif command -v uv >/dev/null 2>&1; then
    uv run python "$@"
  elif [[ -x "/opt/homebrew/bin/python3.14" ]]; then
    /opt/homebrew/bin/python3.14 "$@"
  elif [[ -x "/opt/homebrew/bin/python3.13" ]]; then
    /opt/homebrew/bin/python3.13 "$@"
  elif [[ -x "/opt/homebrew/bin/python3.12" ]]; then
    /opt/homebrew/bin/python3.12 "$@"
  elif [[ -x "/opt/homebrew/bin/python3.11" ]]; then
    /opt/homebrew/bin/python3.11 "$@"
  elif [[ -x "/opt/homebrew/bin/python3.10" ]]; then
    /opt/homebrew/bin/python3.10 "$@"
  else
    echo "ERROR: no usable Python >=3.10 found (need typing.TypeAlias)" >&2
    return 1
  fi
}
run_python -c "from nanovllm_omni import Omni, AsyncOmni, SamplingParams, OmniRequestOutput"
