#!/usr/bin/env bash
# nanovllm-omni pre-push check (full local CI mirror).
#
# Runs the SAME commands as `.github/workflows/ci.yml` so a tree is
# verified locally instead of pushing and waiting. Wired by
# scripts/install-hooks.sh as the git pre-push hook, so it runs once per
# push. The fast `scripts/pre-commit` hook (also installed by
# scripts/install-hooks.sh) still covers lint + format + public-API
# import on every commit; this script adds compileall + the non-smoke
# test suite on top, which are too slow for the commit-time hook.
#
# Run it manually any time:
#   scripts/pre-push

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Prefer project-local venv tools so versions match the CI env. The
# CI workflow installs `[dev]` into a fresh venv; do the same locally
# (`pip install -e ".[dev]"`) so the fallback below finds them.
RUFF=".venv/bin/ruff"
BLACK=".venv/bin/black"
PYTEST=".venv/bin/pytest"
PYTHON=".venv/bin/python"
[[ -x "$RUFF"   ]] || RUFF="ruff"
[[ -x "$BLACK"  ]] || BLACK="black"
[[ -x "$PYTEST" ]] || PYTEST="pytest"
[[ -x "$PYTHON" ]] || PYTHON="python"

# 1. Lint + format.
echo "[pre-push] ruff"
"$RUFF" check nanovllm_omni/ tests/

echo "[pre-push] black"
"$BLACK" --check nanovllm_omni/ tests/

# 2. Public-API import smoke. Catches the most common regression
# class: a renamed or removed public symbol silently breaking
# Omni / AsyncOmni / SamplingParams / OmniRequestOutput users.
echo "[pre-push] public API import"
"$PYTHON" -c "from nanovllm_omni import Omni, AsyncOmni, SamplingParams, OmniRequestOutput"

# 3. compileall -- catches stale imports after deletions or API
# migrations that ruff/pytest can miss on partial runs.
echo "[pre-push] compileall"
"$PYTHON" -m compileall -q nanovllm_omni

# 4. Non-smoke test suite. Smoke tests need real model weights + GPU
# and are excluded by `-m "not smoke"` (matches the CI workflow).
echo "[pre-push] pytest (not smoke)"
"$PYTEST" -m "not smoke" -v

echo "[pre-push] OK"