{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: audio.py (MiniMind-O)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/audio.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${file}",
        "-x",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
