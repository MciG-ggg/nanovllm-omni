#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [[ -x .venv/bin/ruff ]]; then
  .venv/bin/ruff check nanovllm_omni/ tests/
else
  ruff check nanovllm_omni/ tests/
fi
if [[ -x .venv/bin/black ]]; then
  .venv/bin/black --check nanovllm_omni/ tests/
else
  black --check nanovllm_omni/ tests/
fi
